{
  "name": "app-store-connect-mcp",
  "version": "0.1.0",
  "description": "App Store Connect MCP server (high coverage + asc_request escape hatch)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "app-store-connect-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json && node -e \"const fs=require('fs');const p='dist/index.js';if(fs.existsSync(p))fs.chmodSync(p,'755');\"",
    "dev": "npx tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "npx tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "mcp",
    "app-store-connect",
    "apple",
    "asc",
    "model-context-protocol"
  ],
  "author": "Szakacs Media Company",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  }
}
